# Copy this file to .env and fill in your own values.
# Never commit .env with real private key material.
#
# Option 1 (recommended): point to PEM files generated for this deployment.
JWT_ES384_PRIVATE_KEY_PATH=examples/distributed/keys/auth-es384-private.pem
JWT_ES384_PUBLIC_KEY_PATH=examples/distributed/keys/auth-es384-public.pem
#
# Option 2: inline PEM values directly (omit _PATH vars if you do this).
# JWT_ES384_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----..."
# JWT_ES384_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----..."

# Consumer node JWKS discovery (minimal setup requires only JWKS_URL)
JWKS_URL=http://127.0.0.1:3000/.well-known/jwks.json

# Optional hardening knobs for consumer-side JWKS behavior
# JWKS_REFRESH_SECS=60
# JWKS_HTTP_TIMEOUT_MS=3000
# JWKS_CACHE_PATH=examples/distributed/.cache/jwks.json
