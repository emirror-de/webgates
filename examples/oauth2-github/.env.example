# Copy this file to .env and fill in your own values.
# Never commit .env with real client secrets or private key material.

GITHUB_CLIENT_ID=YOUR_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_CLIENT_SECRET
GITHUB_REDIRECT_URL=http://localhost:3000/auth/callback

# Optional app settings
JWT_ISSUER=my-app
AUTH_COOKIE_NAME=auth-token
POST_LOGIN_REDIRECT=/
APP_ADDR=127.0.0.1:3000
JWT_TTL_SECS=900
ALLOW_INSECURE_LOCAL_COOKIES=true

# Optional JWT key configuration
#
# If you leave all JWT_ES384_* variables unset, the example generates a fresh
# ephemeral ES384 key pair on startup. That is convenient for local development,
# but JWTs issued before a restart will stop verifying after the process restarts.
#
# Option 1 (persistent): point to both PEM files.
# JWT_ES384_PRIVATE_KEY_PATH=examples/oauth2-github/keys/auth-es384-private.pem
# JWT_ES384_PUBLIC_KEY_PATH=examples/oauth2-github/keys/auth-es384-public.pem
#
# Option 2: inline both PEM values directly (omit the _PATH vars if you do this).
# JWT_ES384_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----..."
# JWT_ES384_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----..."
