# Copy this file to .env and fill in your own values.
# Never commit .env with real private key material.
#
# Option 1 (recommended): point to PEM files.
JWT_ES384_PRIVATE_KEY_PATH=examples/custom-roles/keys/auth-es384-private.pem
JWT_ES384_PUBLIC_KEY_PATH=examples/custom-roles/keys/auth-es384-public.pem
#
# Option 2: inline PEM values directly (omit _PATH vars if you do this).
# JWT_ES384_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----..."
# JWT_ES384_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----..."
